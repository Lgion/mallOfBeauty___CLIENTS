---
let isAdmin = false;
try {
  const auth = Astro.locals.auth ? Astro.locals.auth() : null;
  const userId = auth?.userId;
  if (userId) {
    const { clerkClient } = await import("@clerk/astro/server");
    const user = await clerkClient(Astro).users.getUser(userId);
    const userEmails: string[] = (user.emailAddresses || [])
      .map(e => e.emailAddress?.trim().toLowerCase())
      .filter(Boolean);
    const rawAdminEmails = (process.env.ADMIN_EMAILS || import.meta.env.ADMIN_EMAILS || "");
    const rawEmployeeEmails = (process.env.ADMIN_EMPLOYE || import.meta.env.ADMIN_EMPLOYE || "");
    const parseEmails = (envVal: string | undefined): string[] => {
      if (!envVal) return [];
      return envVal.split(/[\s,;]+/).map(e => e.trim().toLowerCase()).filter(Boolean);
    };
    const adminEmails = parseEmails(rawAdminEmails);
    const employeeEmails = parseEmails(rawEmployeeEmails);
    if (userEmails.some(e => adminEmails.includes(e) || employeeEmails.includes(e))) {
      isAdmin = true;
    }
  }
} catch (e) {
  isAdmin = false;
}
